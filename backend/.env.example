# Which provider app/detection/service.py wires in: "openrouter" (default),
# "grok", or "groq". Leave unset/openrouter for unchanged existing behavior.
LLM_PROVIDER="openrouter"

# OpenRouter API Key (default LLM provider) - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Model used for both the demo Agent and the Fact Judge (OpenRouter model id)
OPENROUTER_MODEL="openai/gpt-oss-20b:free"

# xAI Grok API Key (only used when LLM_PROVIDER=grok) - Get from https://console.x.ai
# NOTE: this is xAI (x.ai), not Groq (groq.com) — easy to mix up. An xAI key
# does not start with "gsk_"; that prefix belongs to Groq (see below).
XAI_API_KEY="your_xai_api_key_here"

# Model used for both the demo Agent and the Fact Judge (xAI model id).
# This default is PROVISIONAL — verify against a live GET
# https://api.x.ai/v1/models call with your key before trusting it.
XAI_MODEL="grok-4"

# Groq API Key (only used when LLM_PROVIDER=groq) - Get from https://console.groq.com/keys
# Groq is a fast inference host for open-weight models (api.groq.com) — a
# different service from xAI. Groq keys start with "gsk_".
GROQ_API_KEY="your_groq_api_key_here"

# Model used for both the demo Agent and the Fact Judge (Groq model id).
# Verified live against GET https://api.groq.com/openai/v1/models — avoid the
# openai/gpt-oss-* models here, they consistently refuse the LEAKY/OBFUSCATED
# prompts (same weights already tested via OpenRouter).
GROQ_MODEL="qwen/qwen3.6-27b"

# Gemini API Key - retained only because app/agent/gemini.py and
# app/judge/gemini.py still reference these settings. Neither file is
# imported by the running application anymore (see app/detection/service.py,
# which now wires in app/agent/openrouter.py and app/judge/openrouter.py).
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Model Configuration
GEMINI_AGENT_MODEL="gemini-1.5-flash-latest"
GEMINI_JUDGE_MODEL="gemini-1.5-flash-latest"
SEMANTIC_MODEL="all-MiniLM-L6-v2"

# Thresholds for the decision engine
SEMANTIC_BLOCK_THRESHOLD=0.85
FACT_CONFIDENCE_THRESHOLD=0.75
REVIEW_THRESHOLD=0.6

# CORS Origin for Frontend
FRONTEND_ORIGIN="http://localhost:3000"

# Set to "true" only if deployed behind a reverse proxy/load balancer you
# control that sets X-Forwarded-For correctly. Defaults to false — the
# requester IP recorded in audit logs is taken from the direct connection,
# never from a client-supplied header, unless you explicitly opt in here.
TRUST_PROXY_HEADERS="false"

# AWS Configuration (for deployment)
AWS_REGION="us-east-1"
DYNAMODB_TABLE="semantic-guard-audit"
